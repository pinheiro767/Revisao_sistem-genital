                ],
                answer: "Corpo Esponjoso do Pênis"
            },
            // URETRA
            {
                id: 11,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "A porção mais longa da uretra masculina, contida no corpo esponjoso do pênis, é nomeada no roteiro como:",
                icon: "💛",
                options: [
                    { text: "Óstio Interno da Uretra", icon: "⭕" },
                    { text: "Parte Intramural da Uretra", icon: "◼️" },
                    { text: "Parte Prostática da Uretra", icon: "🫘" },
                    { text: "Parte Esponjosa da Uretra", icon: "💛" }
                ],
                answer: "Parte Esponjosa da Uretra"
            },
            {
                id: 12,
                type: "FUNCAO_ESTRUTURA",
                typeLabel: "⚙️ FUNÇÃO DA ESTRUTURA",
                prompt: "Qual porção da uretra é a mais curta e a que atravessa o diafragma urogenital (região mais sujeita a traumas)?",
                icon: "🔶",
                options: [
                    { text: "Parte Esponjosa da Uretra", icon: "💛" },
                    { text: "Parte Prostática da Uretra", icon: "🫘" },
                    { text: "Parte Membranácea da Uretra", icon: "🔶" },
                    { text: "Óstio Externo da Uretra", icon: "⭕" }
                ],
                answer: "Parte Membranácea da Uretra"
            }
        ];

        // feminino-script.js - Conteúdo expandido para cobrir TODO o roteiro prático
        const female_questions = [
            // OVÁRIO E LIGAMENTOS
            {
                id: 1,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "No Ovário, qual ligamento o conecta ao útero, conforme o roteiro?",
                icon: "🔗",
                options: [
                    { text: "Ligamento Largo do Útero", icon: "🎗️" },
                    { text: "Ligamento Redondo do Útero", icon: "⭕" },
                    { text: "Ligamento Próprio do Ovário", icon: "🔗" },
                    { text: "Fímbrias", icon: "🌊" }
                ],
                answer: "Ligamento Próprio do Ovário"
            },
            // TUBA UTERINA
            {
                id: 2,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "Qual é a porção mais estreita e medial da Tuba Uterina, que se une à parede do Útero?",
                icon: "➖",
                options: [
                    { text: "Infundíbulo", icon: "🌸" },
                    { text: "Ampola", icon: "💫" },
                    { text: "Istmo", icon: "➖" },
                    { text: "Fímbrias", icon: "🌊" }
                ],
                answer: "Istmo"
            },
            {
                id: 3,
                type: "FUNCAO_ESTRUTURA",
                typeLabel: "⚙️ FUNÇÃO DA ESTRUTURA",
                prompt: "A parte mais longa e comum da Tuba Uterina, onde geralmente ocorre a fertilização, é a:",
                icon: "💫",
                options: [
                    { text: "Istmo", icon: "➖" },
                    { text: "Infundíbulo", icon: "🌸" },
                    { text: "Ampola", icon: "💫" },
                    { text: "Corpo do Útero", icon: "🟣" }
                ],
                answer: "Ampola"
            },
            {
                id: 4,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "Na Tuba Uterina, qual é a porção próxima ao ovário, com formato de funil, responsável por capturar o oócito após a ovulação?",
                icon: "🌸",
                options: [
                    { text: "Istmo", icon: "➖" },
                    { text: "Ampola", icon: "💫" },
                    { text: "Infundíbulo", icon: "🌸" },
                    { text: "Ovário", icon: "⚪" }
                ],
                answer: "Infundíbulo"
            },
            // ÚTERO
            {
                id: 5,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "Observe o útero. Qual é a camada mais interna que é renovada mensalmente durante o ciclo, conforme listado no roteiro?",
                icon: "🟣",
                options: [
                    { text: "Miométrio", icon: "🔴" },
                    { text: "Perimétrio", icon: "🔵" },
                    { text: "Endométrio", icon: "🟣" },
                    { text: "Corpo do Útero", icon: "⚫" }
                ],
                answer: "Endométrio"
            },
            {
                id: 6,
                type: "FUNCAO_ESTRUTURA",
                typeLabel: "⚙️ FUNÇÃO DA ESTRUTURA",
                prompt: "Qual camada espessa do útero é composta predominantemente por músculo liso?",
                icon: "🔴",
                options: [
                    { text: "Endométrio", icon: "🟣" },
                    { text: "Miométrio", icon: "🔴" },
                    { text: "Perimétrio", icon: "🔵" },
                    { text: "Ligamento Largo do Útero", icon: "🎗️" }
                ],
                answer: "Miométrio"
            },
            {
                id: 7,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "A porção superior, arredondada e acima da entrada das tubas uterinas, é o(a):",
                icon: "🔼",
                options: [
                    { text: "Corpo do Útero", icon: "⚫" },
                    { text: "Fundo do Útero", icon: "🔼" },
                    { text: "Colo do Útero", icon: "🔽" },
                    { text: "Istmo", icon: "➖" }
                ],
                answer: "Fundo do Útero"
            },
            {
                id: 8,
                type: "FUNCAO_ESTRUTURA",
                typeLabel: "⚙️ FUNÇÃO DA ESTRUTURA",
                prompt: "Esta estrutura, mencionada no roteiro, ajuda a manter o útero na sua posição dentro da cavidade pélvica.",
                icon: "🎗️",
                options: [
                    { text: "Ligamento Próprio do Ovário", icon: "🔗" },
                    { text: "Ligamento Redondo", icon: "⭕" },
                    { text: "Ligamento Largo do Útero", icon: "🎗️" },
                    { text: "Istmo", icon: "➖" }
                ],
                answer: "Ligamento Largo do Útero"
            },
            // VAGINA
            {
                id: 9,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "O orifício externo que se abre na vulva (vestíbulo da vagina) é denominado:",
                icon: "⭕",
                options: [
                    { text: "Óstio Externo da Uretra", icon: "💧" },
                    { text: "Clitóris", icon: "💎" },
                    { text: "Óstio Externo da Vagina", icon: "⭕" },
                    { text: "Lábios Menores", icon: "🟡" }
                ],
                answer: "Óstio Externo da Vagina"
            },
            // PUDENDO FEMININO
            {
                id: 10,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "Qual estrutura do pudendo feminino é uma elevação de tecido adiposo, localizada anteriormente à sínfise púbica?",
                icon: "⬆️",
                options: [
                    { text: "Lábios Maiores", icon: "🟤" },
                    { text: "Lábios Menores", icon: "🟡" },
                    { text: "Clitóris", icon: "💎" },
                    { text: "Monte do Púbis", icon: "⬆️" }
                ],
                answer: "Monte do Púbis"
            },
            {
                id: 11,
                type: "IDENTIFICACAO_PECA",
                typeLabel: "🔬 IDENTIFICAÇÃO DE PEÇA",
                prompt: "No PUDENDO FEMININO, identifique a estrutura de tecido erétil responsável pela sensibilidade sexual. Qual o seu nome?",
                icon: "💎",
                options: [
                    { text: "Lábios Maiores", icon: "🟤" },
                    { text: "Lábios Menores", icon: "🟡" },
                    { text: "Clitóris", icon: "💎" },
                    { text: "Monte do Púbis", icon: "⬆️" }
                ],
                answer: "Clitóris"
            }
        ];

        let currentQuestionIndex = 0;
        let score = 0;
        let answerSelected = false;
        let currentQuestions = [];
        let currentSystemType = '';

        function startQuiz(systemType) {
            currentSystemType = systemType;
            currentQuestions = systemType === 'male' ? male_questions : female_questions;
            currentQuestionIndex = 0;
            score = 0;
            
            const config = window.elementSdk ? window.elementSdk.config : defaultConfig;
            
            if (systemType === 'male') {
                document.getElementById('quiz-title').textContent = 'Quiz - Sistema Genital Masculino';
                document.getElementById('quiz-instructions').textContent = 'Identifique as estruturas anatômicas usando a peça física como referência';
            } else {
                document.getElementById('quiz-title').textContent = 'Quiz - Sistema Genital Feminino';
                document.getElementById('quiz-instructions').textContent = 'Identifique as estruturas anatômicas usando a peça física como referência';
            }
            
            document.getElementById('selection-screen').style.display = 'none';
            document.getElementById('quiz-content').style.display = 'block';
            loadQuestion();
        }

        function backToSelection() {
            document.getElementById('completion-screen').style.display = 'none';
            document.getElementById('selection-screen').style.display = 'block';
            document.getElementById('quiz-title').textContent = defaultConfig.quiz_title;
            document.getElementById('quiz-instructions').textContent = defaultConfig.instructions;
        }

        function shuffleArray(array) {
            const newArray = [...array];
            for (let i = newArray.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [newArray[i], newArray[j]] = [newArray[j], newArray[i]];
            }
            return newArray;
        }

        function updateProgress() {
            const progress = (currentQuestionIndex / currentQuestions.length) * 100;
            document.getElementById('progress-fill').style.width = `${progress}%`;
        }

        function updateScore() {
            document.getElementById('score-display').innerHTML = `
                <span>⭐</span>
                <span>${score} / ${currentQuestions.length}</span>
            `;
        }

        function updateQuestionNumber() {
            document.getElementById('question-number').innerHTML = `
                <span>📝</span>
                <span>Pergunta ${currentQuestionIndex + 1} de ${currentQuestions.length}</span>
            `;
        }

        function loadQuestion() {
            if (currentQuestionIndex >= currentQuestions.length) {
                showCompletionScreen();
                return;
            }

            answerSelected = false;
            const currentQuestion = currentQuestions[currentQuestionIndex];
            
            document.getElementById('question-type').textContent = currentQuestion.typeLabel;
            document.getElementById('question-text').textContent = currentQuestion.prompt;
            document.getElementById('anatomy-icon').textContent = currentQuestion.icon;
            document.getElementById('feedback').textContent = '';
            document.getElementById('feedback').className = 'feedback';
            document.getElementById('next-button').disabled = true;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            const shuffledOptions = shuffleArray(currentQuestion.options);
            
            shuffledOptions.forEach(option => {
                const button = document.createElement('button');
                button.className = 'option-button';
                button.innerHTML = `
                    <span class="option-icon">${option.icon}</span>
                    <span class="option-text">${option.text}</span>
                `;
                button.onclick = () => checkAnswer(button, option.text, currentQuestion.answer);
                optionsContainer.appendChild(button);
            });

            updateProgress();
            updateScore();
            updateQuestionNumber();
        }

        function checkAnswer(selectedButton, selectedOption, correctAnswer) {
            if (answerSelected) return;
            
            answerSelected = true;
            const allButtons = document.querySelectorAll('.option-button');
            
            allButtons.forEach(button => {
                button.disabled = true;
                const buttonText = button.querySelector('.option-text').textContent;
                if (buttonText === correctAnswer) {
                    button.classList.add('correct');
                }
            });

            const feedback = document.getElementById('feedback');
            
            if (selectedOption === correctAnswer) {
                score++;
                selectedButton.classList.add('correct');
                feedback.innerHTML = `
                    <span class="feedback-icon">✅</span>
                    <span>Correto! Excelente identificação!</span>
                `;
                feedback.className = 'feedback correct';
            } else {
                selectedButton.classList.add('incorrect');
                feedback.innerHTML = `
                    <span class="feedback-icon">❌</span>
                    <span>Incorreto. A resposta correta é: ${correctAnswer}</span>
                `;
                feedback.className = 'feedback incorrect';
            }

            document.getElementById('next-button').disabled = false;
            updateScore();
        }

        function nextQuestion() {
            currentQuestionIndex++;
            loadQuestion();
        }

        function showCompletionScreen() {
            document.getElementById('quiz-content').style.display = 'none';
            document.getElementById('completion-screen').style.display = 'block';
            
            const incorrect = currentQuestions.length - score;
            const percentage = Math.round((score / currentQuestions.length) * 100);
            
            document.getElementById('final-score').textContent = score;
            document.getElementById('score-label').textContent = `de ${currentQuestions.length} perguntas corretas`;
            document.getElementById('correct-count').textContent = score;
            document.getElementById('incorrect-count').textContent = incorrect;
            document.getElementById('percentage').textContent = `${percentage}%`;
            
            const config = window.elementSdk ? window.elementSdk.config : defaultConfig;
            document.getElementById('completion-message').textContent = config.completion_message || defaultConfig.completion_message;
        }

        function restartQuiz() {
            currentQuestionIndex = 0;
            score = 0;
            document.getElementById('quiz-content').style.display = 'block';
            document.getElementById('completion-screen').style.display = 'none';
            loadQuestion();
        }

        document.getElementById('next-button').addEventListener('click', nextQuestion);

        async function onConfigChange(config) {
            const primaryColor = config.primary_color || defaultConfig.primary_color;
            const secondaryColor = config.secondary_color || defaultConfig.secondary_color;
            const backgroundColor = config.background_color || defaultConfig.background_color;
            const textColor = config.text_color || defaultConfig.text_color;
            const fontFamily = config.font_family || defaultConfig.font_family;
            const baseFontStack = 'Segoe UI, Tahoma, Geneva, Verdana, sans-serif';

            document.body.style.background = `linear-gradient(135deg, ${primaryColor} 0%, ${secondaryColor} 100%)`;
            
            const header = document.querySelector('.quiz-header');
            if (header) {
                header.style.background = `linear-gradient(135deg, ${primaryColor} 0%, ${secondaryColor} 100%)`;
            }

            const container = document.querySelector('.quiz-container');
            if (container) {
                container.style.background = backgroundColor;
            }

            const title = document.querySelector('.quiz-title');
            if (title) {
                title.style.fontFamily = `${fontFamily}, ${baseFontStack}`;
            }

            const questionText = document.querySelector('.question-text');
            if (questionText) {
                questionText.style.fontFamily = `${fontFamily}, ${baseFontStack}`;
                questionText.style.color = textColor;
            }

            const progressFill = document.querySelector('.progress-fill');
            if (progressFill) {
                progressFill.style.background = `linear-gradient(90deg, ${primaryColor} 0%, ${secondaryColor} 100%)`;
            }

            const buttons = document.querySelectorAll('.next-button, .restart-button');
            buttons.forEach(button => {
                button.style.background = `linear-gradient(135deg, ${primaryColor} 0%, ${secondaryColor} 100%)`;
            });

            const scoreDisplay = document.querySelector('.score-display');
            if (scoreDisplay) {
                scoreDisplay.style.color = primaryColor;
            }
        }

        if (window.elementSdk) {
            window.elementSdk.init({
                defaultConfig,
                onConfigChange,
                mapToCapabilities: (config) => ({
                    recolorables: [
                        {
                            get: () => config.primary_color || defaultConfig.primary_color,
                            set: (value) => {
                                config.primary_color = value;
                                window.elementSdk.setConfig({ primary_color: value });
                            }
                        },
                        {
                            get: () => config.secondary_color || defaultConfig.secondary_color,
                            set: (value) => {
                                config.secondary_color = value;
                                window.elementSdk.setConfig({ secondary_color: value });
                            }
                        },
                        {
                            get: () => config.background_color || defaultConfig.background_color,
                            set: (value) => {
                                config.background_color = value;
                                window.elementSdk.setConfig({ background_color: value });
                            }
                        },
                        {
                            get: () => config.text_color || defaultConfig.text_color,
                            set: (value) => {
                                config.text_color = value;
                                window.elementSdk.setConfig({ text_color: value });
                            }
                        }
                    ],
                    borderables: [],
                    fontEditable: {
                        get: () => config.font_family || defaultConfig.font_family,
                        set: (value) => {
                            config.font_family = value;
                            window.elementSdk.setConfig({ font_family: value });
                        }
                    },
                    fontSizeable: undefined
                }),
                mapToEditPanelValues: (config) => new Map([
                    ["quiz_title", config.quiz_title || defaultConfig.quiz_title],
                    ["instructions", config.instructions || defaultConfig.instructions],
                    ["completion_message", config.completion_message || defaultConfig.completion_message]
                ])
            });
        }
    </script>
